{
  "name": "morphtrace",
  "displayName": "MorphTrace",
  "description": "Analyze and generate modeled word forms with explicit morphemes, features, and deterministic rule traces.",
  "version": "0.1.1",
  "publisher": "aryansudhir",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:morphtrace.analyzeSelectedWord",
    "onCommand:morphtrace.generateWordForm"
  ],
  "contributes": {
    "commands": [
      {
        "command": "morphtrace.analyzeSelectedWord",
        "title": "MorphTrace: Analyze Selected Word"
      },
      {
        "command": "morphtrace.generateWordForm",
        "title": "MorphTrace: Generate Word Form"
      }
    ],
    "configuration": {
      "title": "MorphTrace",
      "properties": {
        "morphtrace.grammarPath": {
          "type": "string",
          "default": "",
          "description": "Optional workspace-relative path to a MorphTrace grammar JSON file."
        }
      }
    }
  },
  "dependencies": {
    "@morphtrace/core": "file:../core"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AryanSudhirDev/morphtrace.git"
  },
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#151B3D",
    "theme": "dark"
  },
  "keywords": [
    "morphology",
    "linguistics",
    "computational linguistics",
    "morphemes",
    "word formation",
    "grammar",
    "cursor",
    "vscode"
  ],
  "homepage": "https://github.com/AryanSudhirDev/morphtrace#readme",
  "bugs": {
    "url": "https://github.com/AryanSudhirDev/morphtrace/issues"
  }
}
