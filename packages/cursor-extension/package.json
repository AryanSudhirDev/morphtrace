{
  "name": "morphtrace",
  "displayName": "ContextCheck",
  "description": "Review whether an AI summary preserves important instructions, constraints, approvals, and scope.",
  "version": "0.1.2",
  "publisher": "aryansudhir",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:contextcheck.checkSummary",
    "onCommand:contextcheck.loadSourceConversation",
    "onCommand:contextcheck.reviewFindings",
    "onCommand:contextcheck.exportReviewReport"
  ],
  "contributes": {
    "commands": [
      {
        "command": "contextcheck.checkSummary",
        "title": "ContextCheck: Check Summary Against Conversation"
      },
      {
        "command": "contextcheck.loadSourceConversation",
        "title": "ContextCheck: Load Source Conversation"
      },
      {
        "command": "contextcheck.reviewFindings",
        "title": "ContextCheck: Review Findings"
      },
      {
        "command": "contextcheck.exportReviewReport",
        "title": "ContextCheck: Export Review Report"
      },
      {
        "command": "contextcheck.clearSavedReviewData",
        "title": "ContextCheck: Clear Saved Review Data"
      }
    ]
  },
  "dependencies": {
    "@contextcheck/core": "file:../core"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AryanSudhirDev/morphtrace.git"
  },
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#151B3D",
    "theme": "dark"
  },
  "keywords": [
    "ai safety",
    "summary review",
    "instruction preservation",
    "handoffs",
    "context",
    "cursor",
    "vscode"
  ],
  "homepage": "https://github.com/AryanSudhirDev/morphtrace#readme",
  "bugs": {
    "url": "https://github.com/AryanSudhirDev/morphtrace/issues"
  }
}
